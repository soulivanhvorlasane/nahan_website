<odoo>

    <!-- ============================================== -->
    <!-- SERVICES DETAILED PAGE                         -->
    <!-- ============================================== -->
    <template id="services_page" name="Our Services - Nahan.app Odoo 18">
        <t t-call="website.layout">
            <t t-set="additional_title">Our Services | Odoo 18 ERP &amp; TaxRIS Solutions in Laos | Nahan.app</t>
            <div id="wrap" class="nahan-body">

                <!-- Services Hero -->
                <section class="nahan-hero-section py-5">
                    <div class="container text-center py-4">
                        <span class="hero-badge">Full Spectrum ERP &amp; Integrations</span>
                        <h1 class="hero-title mt-2">
                            <span>Tailored Odoo 18 Solutions for</span> <span class="text-gradient">Lao Enterprises</span>
                        </h1>
                        <p class="hero-subtitle mx-auto">
                            Transforming manual operations into synchronized digital workflows. We provide end-to-end consulting, customization, and Lao national tax integration.
                        </p>
                    </div>
                </section>

                <!-- In-depth Services Detail Section -->
                <section class="py-5" id="odoo18">
                    <div class="container py-4">
                        <!-- 1. ERP Implementation Breakdown (#erp) -->
                        <div class="row align-items-center g-5 mb-5 p-4 p-lg-5 rounded-4 bg-white border shadow-sm" id="erp">
                            <div class="col-lg-6 order-lg-2">
                                <span class="section-eyebrow">Enterprise Core</span>
                                <h2 class="fw-bold text-dark mt-2 mb-3">Turnkey Odoo 18 ERP Implementation</h2>
                                <p class="text-muted">
                                    A successful ERP project requires more than installing software—it requires aligning technology with human workflows. We guide your team from legacy systems to a unified Odoo platform.
                                </p>
                                <div class="row g-3 mt-1">
                                    <div class="col-sm-6">
                                        <div class="p-3 bg-light rounded">
                                            <h6 class="fw-bold text-dark mb-1">Standardized Chart of Accounts</h6>
                                            <p class="small text-muted mb-0">Pre-configured with standard Lao accounting accounts.</p>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-3 bg-light rounded">
                                            <h6 class="fw-bold text-dark mb-1">Data Migration</h6>
                                            <p class="small text-muted mb-0">Clean import of legacy products, customers, and opening balances.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 order-lg-1 text-center">
                                <div class="p-4 bg-light rounded-4 border">
                                    <i class="fa fa-cubes text-primary" style="font-size: 4rem;"></i>
                                    <h4 class="fw-bold mt-3">Full Suite ERP</h4>
                                    <p class="text-muted small">Sales • Inventory • Accounting • Purchasing • HR</p>
                                </div>
                            </div>
                        </div>

                        <!-- 2. TaxRIS & API Integration Feature Highlight (#api / #taxris) -->
                        <div class="row align-items-center g-5 mb-5 p-4 p-lg-5 rounded-4 bg-white border shadow-sm" id="taxris">
                            <span id="api" class="d-none"></span>
                            <div class="col-lg-6">
                                <span class="section-eyebrow">National Tax &amp; API Connectivity</span>
                                <h2 class="fw-bold text-dark mt-2 mb-3">Lao TaxRIS &amp; API Integration</h2>
                                <p class="text-muted">
                                    The Lao Tax Department (Ministry of Finance) requires companies to issue electronic tax invoices connected to the TaxRIS system.
                                    Our battle-tested Odoo 18 connector guarantees your business stays 100% legally compliant.
                                </p>
                                <ul class="list-unstyled text-muted">
                                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>Real-time invoice synchronization with TaxRIS API endpoints</li>
                                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>Automated generation of official TaxRIS QR code on POS receipts</li>
                                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>Multi-currency VAT calculation compliant with Lao tax brackets</li>
                                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>Direct export for monthly and quarterly Lao tax declarations</li>
                                </ul>
                                <a href="/contact-us" class="btn btn-nahan-primary mt-2">
                                    Request API &amp; TaxRIS Demo
                                </a>
                            </div>
                            <div class="col-lg-6 text-center">
                                <img src="/nahan_website/static/src/img/taxris_badge.svg" alt="TaxRIS API Lao Integration" style="max-width: 240px;" class="img-fluid mb-3 d-block mx-auto"/>
                                <div class="p-3 bg-light rounded text-start small border">
                                    <code class="text-primary font-monospace">// TaxRIS API Sync Payload Sample</code>
                                    <pre class="mt-2 mb-0" style="font-size: 11px; background: #0A2540; color: #38BDF8; padding: 12px; border-radius: 6px;">
POST /api/v1/einvoice/issue
{
  "tin": "0100234567-000",
  "invoice_no": "INV/2026/0042",
  "currency": "LAK",
  "tax_amount": 350000.0,
  "status": "APPROVED_BY_TAXRIS"
}</pre>
                                </div>
                            </div>
                        </div>

                        <!-- POS & Retail Solutions -->
                        <div class="row align-items-center g-5 mb-5 p-4 p-lg-5 rounded-4 bg-white border shadow-sm" id="pos">
                            <div class="col-lg-6">
                                <span class="section-eyebrow">Retail &amp; Hospitality</span>
                                <h2 class="fw-bold text-dark mt-2 mb-3">Modern POS &amp; Store Management</h2>
                                <p class="text-muted">
                                    Whether you run a single boutique or a multi-branch supermarket chain in Laos, our Odoo 18 POS setup provides lightning-fast checkout, barcode scanning, and multi-till control.
                                </p>
                                <ul class="list-unstyled text-muted">
                                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>Works offline during internet drops; automatically syncs when reconnected</li>
                                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>Integrated Lao QR code payment on customer-facing screens</li>
                                    <li class="mb-2"><i class="fa fa-check text-success me-2"></i>Real-time stock deduction and low-stock alerts</li>
                                </ul>
                            </div>
                            <div class="col-lg-6 text-center">
                                <div class="p-4 bg-light rounded-4 border">
                                    <i class="fa fa-desktop text-success" style="font-size: 4rem;"></i>
                                    <h4 class="fw-bold mt-3">Odoo 18 Point of Sale</h4>
                                    <p class="text-muted small">Retail Counters • Table Management • Kitchen Printing</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- Call to action -->
                <div class="container mb-5">
                    <div class="nahan-cta-banner text-center">
                        <h2 class="cta-title">Ready to Discuss Your Project?</h2>
                        <p class="cta-subtitle mx-auto">Contact our team in Vientiane for a detailed scope of work and consultation.</p>
                        <div class="mt-4">
                            <a href="/contact-us" class="btn btn-nahan-primary btn-lg shadow px-5">Get in Touch</a>
                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>

