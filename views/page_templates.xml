    <!-- ============================================== -->
    <!-- CONTACT US PAGE                                -->
    <!-- ============================================== -->
    <template id="contact_page" name="Contact Us - Nahan.app Odoo 18">
        <t t-call="website.layout">
            <t t-set="additional_title">Contact Us | Request Free Odoo 18 ERP Consultation | Nahan.app</t>
            <t t-set="comp" t-value="res_company or (website and website.company_id) or request.env.company"/>
            <t t-set="raw_phone" t-value="comp.phone if comp and comp.phone else '02052746767'"/>
            <t t-set="clean_digits" t-value="''.join([c for c in raw_phone if c.isdigit()])"/>
            <t t-set="wa_number" t-value="'856' + clean_digits[1:] if clean_digits.startswith('020') else ('856' + clean_digits if clean_digits.startswith('20') else clean_digits)"/>
            <div id="wrap" class="nahan-body">

                <!-- Contact Hero -->
                <section class="nahan-hero-section py-5">
                    <div class="container text-center py-4">
                        <span class="hero-badge">Direct Communication</span>
                        <h1 class="hero-title mt-2">
                            <span>Get in Touch with</span> <span class="text-gradient"><t t-esc="comp.name if comp and comp.name else 'Nahan.app'"/></span>
                        </h1>
                        <p class="hero-subtitle mx-auto">
                            Have questions about Odoo 18 or TaxRIS API integration? Our consultants in Vientiane are ready to assist.
                        </p>
                    </div>
                </section>

                <!-- Contact Channels & Form -->
                <section class="py-5">
                    <div class="container py-4">
                        <div class="row g-5">
                            <!-- Left: Contact Details -->
                            <div class="col-lg-5">
                                <div class="p-4 bg-white rounded-4 border shadow-sm h-100">
                                    <span class="section-eyebrow">Headquarters</span>
                                    <h3 class="fw-bold text-dark mt-2 mb-4">Vientiane Office</h3>

                                    <div class="d-flex align-items-start gap-3 mb-4">
                                        <div class="fs-4 text-primary"><i class="fa fa-map-marker"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Office Address</h6>
                                            <p class="text-muted small mb-0">
                                                <t t-if="comp and (comp.street or comp.city)">
                                                    <span t-if="comp.street" t-field="comp.street"/>
                                                    <t t-if="comp.street2">, <span t-field="comp.street2"/></t>
                                                    <t t-if="comp.city">, <span t-field="comp.city"/></t>
                                                    <t t-if="comp.state_id">, <span t-field="comp.state_id.name"/></t>
                                                    <t t-if="comp.zip"> <span t-field="comp.zip"/></t>
                                                    <t t-if="comp.country_id">, <span t-field="comp.country_id.name"/></t>
                                                </t>
                                                <t t-else="">
                                                    <span>Ban Vansay, Saysettha, Vientiane Capital, Laos</span>
                                                </t>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-start gap-3 mb-4">
                                        <div class="fs-4 text-success"><i class="fa fa-phone"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Direct Call &amp; WhatsApp</h6>
                                            <p class="text-muted small mb-0">
                                                <a t-attf-href="tel:#{comp.phone if comp and comp.phone else '02052746767'}" class="text-decoration-none text-muted">
                                                    <span t-if="comp and comp.phone" t-field="comp.phone"/>
                                                    <span t-else="">02052746767</span>
                                                </a>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-start gap-3 mb-4">
                                        <div class="fs-4 text-info"><i class="fa fa-envelope"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Email Inquiries</h6>
                                            <p class="text-muted small mb-0">
                                                <a t-attf-href="mailto:#{comp.email if comp and comp.email else 'vorlasanedev@gmail.com'}" class="text-decoration-none text-muted">
                                                    <span t-if="comp and comp.email" t-field="comp.email"/>
                                                    <span t-else="">vorlasanedev@gmail.com</span>
                                                </a>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Dynamic Tax ID / TIN -->
                                    <div t-if="comp and comp.vat" class="d-flex align-items-start gap-3 mb-4">
                                        <div class="fs-4 text-secondary"><i class="fa fa-file-text-o"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Tax ID / TIN</h6>
                                            <p class="text-muted small mb-0">
                                                <span t-field="comp.vat"/>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Dynamic Company Registry / ID -->
                                    <div t-if="comp and comp.company_registry" class="d-flex align-items-start gap-3 mb-4">
                                        <div class="fs-4 text-secondary"><i class="fa fa-id-card-o"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Company Registry No.</h6>
                                            <p class="text-muted small mb-0">
                                                <span t-field="comp.company_registry"/>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-start gap-3 mb-4">
                                        <div class="fs-4 text-warning"><i class="fa fa-clock-o"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-1">Business Hours</h6>
                                            <p class="text-muted small mb-0">Monday – Friday: 08:30 - 17:30 (ICT)</p>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-3 border-top">
                                        <h6 class="fw-bold mb-2">Instant Chat via WhatsApp</h6>
                                        <a t-attf-href="https://wa.me/#{wa_number}?text=Hello%20#{comp.name if comp and comp.name else 'Nahan'},%20I%20would%20like%20to%20consult%20about%20Odoo%2018%20in%20Laos" 
                                           class="btn btn-success w-100 py-2 fw-bold" target="_blank" rel="noopener">
                                            <i class="fa fa-whatsapp me-2"></i>Chat on WhatsApp (<span t-esc="comp.phone if comp and comp.phone else '02052746767'"/>)
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Consultation Form -->
                            <div class="col-lg-7">
                                <div class="nahan-consultation-card shadow-sm">
                                    <div class="mb-4">
                                        <h3 class="fw-bold text-dark mb-1">Send Us a Message</h3>
                                        <p class="text-muted small">Fill out the form below to request a free consultation or quotation.</p>
                                    </div>

                                    <div id="nahanFormResponse"></div>

                                    <form id="nahanConsultationForm" method="POST" action="/consultation/submit">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="redirect_url" value="/contact-us?submitted=1"/>
                                        
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label">Company Name *</label>
                                                <input type="text" name="company_name" class="form-control" placeholder="Company Name" required="required"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Your Name *</label>
                                                <input type="text" name="contact_name" class="form-control" placeholder="Full Name" required="required"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Phone / WhatsApp *</label>
                                                <input type="tel" name="phone" class="form-control" placeholder="+856 20 ..." required="required"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Email *</label>
                                                <input type="email" name="email" class="form-control" placeholder="email@company.la" required="required"/>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Industry</label>
                                                <select name="business_type" class="form-select">
                                                    <option value="">Select industry...</option>
                                                    <option value="retail">Retail / POS</option>
                                                    <option value="wholesale">Wholesale &amp; Distribution</option>
                                                    <option value="manufacturing">Manufacturing</option>
                                                    <option value="services">Services</option>
                                                    <option value="hospitality">Hospitality &amp; Restaurant</option>
                                                    <option value="other">Other / Startup</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Team Size</label>
                                                <select name="employee_count" class="form-select">
                                                    <option value="1-10">1 - 10 Employees</option>
                                                    <option value="11-50">11 - 50 Employees</option>
                                                    <option value="51-200">51 - 200 Employees</option>
                                                    <option value="200+">200+ Employees</option>
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label">Message / Details</label>
                                                <textarea name="message" rows="4" class="form-control" placeholder="Tell us how we can help your business..."></textarea>
                                            </div>
                                            <div class="col-12 mt-3">
                                                <button type="submit" class="btn btn-nahan-primary btn-lg w-100 py-3 btn-consultation-submit shadow">
                                                    Submit Consultation Request
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

